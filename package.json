{
  "name": "videocut-edvault",
  "private": true,
  "description": "Відеоредактор Edvault: різання, текст, субтитри, музика, експорт у MP4. Статична сторінка, без збирання.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/videocut-e2e.mjs",
    "build": "node scripts/preload.mjs",
    "audit": "npm run audit:build && npm run audit:a11y && npm run audit:keyboard && npm run audit:perf && npm run audit:stress",
    "audit:build": "node scripts/preload.mjs --check",
    "audit:a11y": "node scripts/audit/a11y.mjs",
    "audit:perf": "node scripts/audit/perf.mjs",
    "audit:keyboard": "node scripts/audit/keyboard.mjs",
    "audit:stress": "node scripts/audit/stress.mjs",
    "test:scenarios": "node tests/videocut-scenarios-e2e.mjs",
    "test:color": "node tests/videocut-color-e2e.mjs && node tests/videocut-color-ui-e2e.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.49.1"
  },
  "type": "module"
}
